# Keine Passwörter oder Schlüssel in dieser Datei. Installer erhält vorhandene Werte.
COMPOSE_PROJECT_NAME=sterracode
STERRACODE_BIND_IP=127.0.0.1
STERRACODE_PORT=3000
STERRACODE_PUBLIC_URL=http://127.0.0.1:3000
STERRACODE_EXTRA_ALLOWED_HOSTS=
STERRACODE_EXTRA_ALLOWED_ORIGINS=
STERRACODE_TRUSTED_PROXIES=
# off | caddy | host | docker
STERRACODE_PROXY_MODE=off
STERRACODE_DOMAIN=
# Bei caddy: empty für öffentliche ACME-Zertifikate; internal für lokales HTTPS.
STERRACODE_TLS_MODE=internal
STERRACODE_LM_STUDIO_URL=http://host.docker.internal:1234
# Optional: absoluter Pfad einer geschützten Token-Datei, nur bei secret overlay.
# STERRACODE_LM_STUDIO_TOKEN_PATH=/absolute/path/lm-token
# Externer Docker-Proxy: vorhandenes Netzwerk, kein Docker-Socket-Mount.
STERRACODE_PROXY_NETWORK=proxy
# Nur beim ersten Manifest angewandt: comma separated catalog IDs.
STERRACODE_INITIAL_PROGRAMS=
# Optional: initiales Administratorpasswort aus Datei, nur für unbeaufsichtigte Ersteinrichtung.
# STERRACODE_ADMIN_PASSWORD_PATH=/absolute/path/admin-password
# STERRACODE_OPENAI_API_KEY_PATH=/absolute/path/openai-key
# STERRACODE_CADDY_IP=172.30.123.2
# STERRACODE_BACKEND_SUBNET=172.30.123.0/24
