{
  "name": "sterracode",
  "version": "1.0.0",
  "type": "module",
  "description": "KI-gestützte Coding-Lernumgebung mit LM Studio",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:docker": "node tests/docker/smoke.mjs",
    "test:context:live": "node scripts/check-context-live.mjs",
    "format:check": "prettier --check public server runner docker tests scripts *.config.js"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "dependencies": {
    "@lmstudio/sdk": "2.1.0",
    "express": "^4.18.0",
    "monaco-editor": "^0.47.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "prettier": "^3.9.10",
    "vitest": "^5.0.5"
  }
}
