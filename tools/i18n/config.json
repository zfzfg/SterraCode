{
  "version": 1,
  "roots": [
    "public",
    "server",
    "runner",
    "scripts",
    "docker",
    "tests",
    "shared",
    "locales"
  ],
  "excludeDirectories": [
    ".git",
    "node_modules",
    "data",
    "backups",
    "docker-backups",
    "secrets",
    ".secrets",
    "__pycache__",
    "test-results",
    "playwright-report"
  ],
  "extensions": [
    ".js",
    ".mjs",
    ".cjs",
    ".html",
    ".svg",
    ".css",
    ".py",
    ".ps1",
    ".sh",
    ".bat",
    ".c",
    ".json",
    ".yaml",
    ".yml",
    ".lock"
  ],
  "rootNames": ["Dockerfile", "Dockerfile.runner", ".env.example", "Caddyfile"],
  "maxSourceBytes": 2097152,
  "maxGraphPasses": 24,
  "maxTraceNodes": 120000,
  "maxPropertyDepth": 128,
  "textProperties": [
    "label",
    "title",
    "description",
    "explanation",
    "help",
    "placeholder",
    "submit",
    "question",
    "message",
    "error",
    "reason",
    "progress",
    "goal",
    "milestone",
    "category",
    "hint",
    "hints",
    "checklist",
    "prerequisites",
    "features",
    "runtime"
  ],
  "textAttributes": [
    "title",
    "alt",
    "placeholder",
    "aria-label",
    "aria-description",
    "aria-valuetext",
    "label"
  ],
  "textAssignments": [
    "textContent",
    "innerText",
    "innerHTML",
    "title",
    "placeholder",
    "ariaLabel",
    "ariaDescription",
    "ariaValueText"
  ],
  "translationCalls": ["t", "i18n.t", "i18next.t"],
  "translationSignatures": [
    {
      "module": "server/services/i18n.js",
      "export": "t",
      "keyArgument": 1,
      "optionsArgument": 2
    }
  ],
  "sinks": [
    { "call": "node", "arguments": [2], "channel": "ui" },
    { "call": "button", "arguments": [0], "channel": "ui" },
    { "call": "toast", "arguments": [0], "channel": "ui" },
    { "call": "setButton", "arguments": [1], "channel": "ui" },
    { "call": "confirmDialog", "arguments": [0, 1], "channel": "ui" },
    { "call": "taskSection", "arguments": [2], "channel": "ui" },
    { "call": "formDialog", "arguments": [0], "channel": "ui", "fields": true },
    { "call": "markdown", "arguments": [0], "channel": "ui" },
    { "call": "document.createTextNode", "arguments": [0], "channel": "ui" },
    { "call": "alert", "arguments": [0], "channel": "ui" },
    { "call": "confirm", "arguments": [0], "channel": "ui" },
    { "call": "prompt", "arguments": [0, 1], "channel": "ui" },
    { "call": "AppError", "arguments": [0], "channel": "api-error" },
    { "call": "APIError", "arguments": [0], "channel": "api-error" },
    { "call": "RunnerError", "arguments": [0], "channel": "runner-error" },
    { "call": "Error", "arguments": [0], "channel": "exception" },
    { "call": "TypeError", "arguments": [0], "channel": "exception" },
    { "call": "DOMException", "arguments": [0], "channel": "exception" }
  ],
  "catalogs": {
    "baseLocale": "de",
    "requiredLocales": ["de", "en", "es"],
    "roots": ["shared/i18n/locales", "public/locales", "locales"],
    "defaultNamespace": "translation"
  },
  "invariantDisplayValues": {
    "SterraCode": "Produktname",
    "OpenAI": "Anbietername",
    "LM Studio": "Produktname",
    "Python": "Programmiersprache",
    "JavaScript": "Programmiersprache",
    "Java": "Programmiersprache",
    "C++": "Programmiersprache",
    "C#": "Programmiersprache",
    "Go": "Programmiersprache",
    "Rust": "Programmiersprache",
    "Bash": "Shellname",
    "Lua": "Programmiersprache",
    "HTML": "Technologiebezeichnung",
    "CSS": "Technologiebezeichnung",
    "JSON": "Datenformat",
    "UTF-8": "Zeichenkodierung",
    "Solarized": "Name eines Farbthemas"
  },
  "exceptions": []
}
